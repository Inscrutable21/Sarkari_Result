{
  "name": "sarkari-result-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node.js backend and static frontend server for sarkari hith",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-path=server.js --watch-path=src/services server.js",
    "scrape": "node src/services/scraper/runScraper.js",
    "notify": "node src/services/sendNotifications.js",
    "sync:mongo": "node src/services/pushAllDataToMongo.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "mongodb": "^7.7.0",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "puppeteer": "^25.12.0"
  }
}
