# ========================================================
# Sarkari Hith (sarkari hith 2026) - Environment Template
# Copy this file to .env and configure your values.
# ========================================================

# Server Configuration
PORT=3000
PORTAL_URL=http://localhost:3000

# Cloud Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=sarkari_hith

# Single Master Admin Key (Required for /admin console & API tokens)
ADMIN_API_KEY=your_generated_secret_admin_key_here
SESSION_SECRET=your_jwt_or_session_signing_secret_here

# SMTP Email Configuration (Nodemailer)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password_here
NOTIFICATION_FROM_EMAIL="Sarkari Hith Job Alerts" <your_email@gmail.com>
# Optional custom SMTP relay:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Scheduled Daily Reminders (18:00 IST / 6:00 PM)
TIMEZONE=Asia/Kolkata
REMINDER_TRIGGER_HOUR=18
REMINDER_TRIGGER_MINUTE=0

# Vercel Cron Authentication Secret
CRON_SECRET=your_vercel_cron_secret_here
